# Copy to .env.local for local dev (untracked). Matches docker-compose.yml.

DATABASE_URL=postgres://madani:madani@localhost:5433/madani_elearning

# S3-compatible storage — MinIO locally, real R2/S3 in prod (R2 is
# S3-compatible, so these same vars point at it with no code change).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=madani-elearning-content
S3_ACCESS_KEY_ID=madani
S3_SECRET_ACCESS_KEY=madani123
# MinIO needs path-style URLs (bucket.endpoint doesn't resolve locally);
# real S3/R2 also accept path-style, so this can stay true everywhere.
S3_FORCE_PATH_STYLE=true

# Email (SMTP) — Mailpit locally (catch-all inbox, view at localhost:8025),
# a real SMTP relay or SES's SMTP interface in prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@madani.school

# WhatsApp via WAHA (self-hosted WhatsApp HTTP API). The session must be
# linked once via the WAHA dashboard (http://localhost:3001) — see README.
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=

# Cache for expensive aggregate queries (see AnalyticsService). Optional in
# the sense that the app fails open if this is unreachable — just slower.
# HTTP (@upstash/redis), not a redis:// URL — chosen for Cloudflare Workers
# compatibility (see RFC 0004). `redis-http` in docker-compose.yml is a REST
# proxy in front of local `redis`, so this points at it the same way it'll
# point at real Upstash in prod.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=madani-local-token
